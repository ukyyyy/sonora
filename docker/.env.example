# ── Sonora docker/.env.example ────────────────────────────────────────────────
#
# You do NOT need to edit this file manually.
# Run ./docker/start.sh and it will generate docker/.env with secure random
# values automatically.
#
# Only use this file if you want to pre-set specific values before the first run:
#   cp docker/.env.example docker/.env
#   # edit docker/.env
#   ./docker/start.sh
# ─────────────────────────────────────────────────────────────────────────────

# Postgres
POSTGRES_PASSWORD=change-me-to-a-strong-random-password
POSTGRES_DB=postgres
POSTGRES_USER=postgres

# JWT (used by GoTrue + PostgREST + Storage — must be >= 32 chars)
# Change this in production. start.sh will re-sign ANON_KEY and SERVICE_ROLE_KEY
# automatically whenever this value changes.
JWT_SECRET=change-me-to-a-very-long-random-string-min-32-chars
JWT_EXPIRY=3600

# Pre-signed JWTs for the JWT_SECRET above.
# These are the standard Supabase demo keys (public — NOT safe for production).
# start.sh generates secure keys automatically; these are fallbacks only.
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# Public URL the browser and Replit app hit (the nginx gateway).
# Replace YOUR_VPS_IP with your server's public IP, or a domain if using HTTPS.
SUPABASE_PUBLIC_URL=http://YOUR_VPS_IP:8000

# The URL of your Replit app (used by GoTrue for redirect links in emails).
SITE_URL=https://your-project.replit.app

# Ports (start.sh picks free ports automatically if these are taken)
APP_PORT=3000
GATEWAY_PORT=8000
