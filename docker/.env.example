# ---- Copy to docker/.env and edit ----
# Postgres
POSTGRES_PASSWORD=super-secret-postgres-pw
POSTGRES_DB=postgres
POSTGRES_USER=postgres

# JWT (used by GoTrue + PostgREST + Storage)
# Must be >=32 chars. Change for production!
JWT_SECRET=change-me-to-a-very-long-random-string-min-32-chars
JWT_EXPIRY=3600

# Pre-signed anon + service_role JWTs matching JWT_SECRET above.
# These are the standard Supabase self-host demo keys signed with the demo secret
# "your-super-secret-jwt-token-with-at-least-32-characters-long".
# If you change JWT_SECRET, regenerate these (see README).
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU
# When using the ANON_KEY above, JWT_SECRET must be:
# your-super-secret-jwt-token-with-at-least-32-characters-long

# Public URL the browser hits (the nginx gateway). Update if you expose a domain.
SUPABASE_PUBLIC_URL=http://localhost:8000
SITE_URL=http://localhost:3000

# App
APP_PORT=3000
GATEWAY_PORT=8000
